# Copy this file to .env and fill in your own Gmail API credentials.
# Nothing is sent to any third-party form/email service -- this sends mail
# through your own Gmail account via Google's Gmail API (HTTPS), not SMTP.
# SMTP is blocked outbound on many free hosting tiers; the Gmail API isn't.

PORT=3000

# From Google Cloud Console > APIs & Services > Credentials (OAuth client, "Desktop app")
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret

# Obtained once via the one-time OAuth authorization script (see README)
GMAIL_REFRESH_TOKEN=your-refresh-token

# The Gmail address these credentials belong to -- mail is sent "from" this address
GMAIL_USER=your-address@gmail.com

# Optional: send yourself a copy of every submission
MAIL_BCC=

# Optional: logs every submission as a row in this Google Sheet (see README for
# how to create it). Leave unset to skip sheet logging entirely.
GOOGLE_SHEET_ID=
