# Copy this file to .env and fill in your own SMTP account.
# Nothing is sent to any third-party form/email service -- this is only
# used to talk directly to your mail provider's SMTP server.

PORT=3000

# Example for Gmail: smtp.gmail.com / 587 / an "App Password" (not your normal password)
# Google requires 2-factor auth enabled + an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-address@gmail.com

# Optional: send yourself a copy of every submission
MAIL_BCC=
